<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light">
        <item name="android:textColorPrimary">@android:color/black</item>
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="android:actionBarStyle">@style/BlackTextActionBar</item>
        <item name="android:colorPrimary">@color/white</item>
        <item name="android:colorPrimaryDark">@color/white</item>
    </style>
    <style name="BlackActionBarTitle" parent="@android:style/TextAppearance.Material.Widget.ActionBar.Title">
        <item name="android:textColor">#ff000000</item>
        <item name="android:alpha">1</item>
    </style>
    <style name="BlackTextActionBar" parent="@android:style/Widget.Material.Light.ActionBar">
        <item name="android:textColorSecondary">@android:color/black</item>
        <item name="android:background">@color/white</item>
        <item name="android:titleTextStyle">@style/BlackActionBarTitle</item>
    </style>
</resources>
